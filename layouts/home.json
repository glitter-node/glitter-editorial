{
  "version": "0.1.0-beta.24",
  "layout_name": "home",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "data_sources": [],
      "priority": 1.0,
      "changefreq": "weekly",
      "og": {
        "type": "website",
        "title": "$t:meta.home_title",
        "description": "$t:meta.home_description"
      },
      "structured_data": {
        "@type": "WebSite",
        "name": "$t:common.brand"
      }
    }
  },
  "data_sources": [],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": { "className": "page home-page shell-width" },
        "children": [
          { "partial": "partials/home/_lead.json" },
          {
            "type": "composite",
            "name": "EditorialFeed",
            "props": {
              "labelText": "$t:home.latest.label",
              "titleText": "$t:home.latest.title",
              "featuredLabelText": "$t:home.featured.label",
              "readText": "$t:home.featured.read",
              "allStoriesText": "$t:home.latest.all",
              "emptyTitleText": "$t:home.empty.title",
              "emptyBodyText": "$t:home.empty.body",
              "sectionDiscoveryLabelText": "$t:home.sections.label",
              "sectionDiscoveryTitleText": "$t:home.sections.title",
              "sectionDiscoveryNavLabelText": "$t:home.sections.nav_label",
              "pageSize": 6,
              "variant": "home"
            }
          },
          { "partial": "partials/home/_principles.json" },
          { "partial": "partials/home/_scope.json" },
          { "partial": "partials/home/_closing.json" }
        ]
      }
    ]
  }
}
