{
  "version": "0.1.0-beta.24",
  "layout_name": "article",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "data_sources": ["post"],
      "priority": 0.7,
      "changefreq": "weekly",
      "og": {
        "type": "article",
        "title": "{{post.data.title ?? 'Article'}}",
        "description": "$t:article.meta_description",
        "image": "{{post.data.thumbnail ?? ''}}",
        "image_alt": "{{post.data.title ?? ''}}"
      }
    }
  },
  "data_sources": [
    {
      "id": "post",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/editorial/posts/{{route.id}}",
      "method": "GET",
      "auto_fetch": false,
      "auth_mode": "guest",
      "fallback": {}
    }
  ],
  "slots": {
    "content": [
      {
        "type": "composite",
        "name": "EditorialArticle",
        "props": {
          "articleId": "{{route.id}}",
          "loadingText": "$t:article.loading",
          "invalidTitleText": "$t:article.invalid.title",
          "invalidBodyText": "$t:article.invalid.body",
          "unavailableTitleText": "$t:article.unavailable.title",
          "unavailableBodyText": "$t:article.unavailable.body",
          "forbiddenTitleText": "$t:article.forbidden.title",
          "forbiddenBodyText": "$t:article.forbidden.body",
          "notFoundTitleText": "$t:article.not_found.title",
          "notFoundBodyText": "$t:article.not_found.body",
          "backText": "$t:article.back",
          "previousText": "$t:article.previous",
          "nextText": "$t:article.next",
          "className": "shell-width"
        }
      }
    ]
  }
}
